{
  "modes": [
    {
      "name": "disabled",
      "photon": false,
      "mediaRedirectDomain": "",
      "redirectBase": "",
      "contains": []
    },
    {
      "name": "redirect-bare-domain",
      "photon": false,
      "mediaRedirectDomain": "example.test",
      "redirectBase": "https://example.test",
      "contains": [ "try_files $uri @prod_site;", "https://example.test/$1", "location @prod_site" ]
    },
    {
      "name": "redirect-https",
      "photon": false,
      "mediaRedirectDomain": "https://example.test",
      "redirectBase": "https://example.test",
      "contains": [ "try_files $uri @prod_site;", "https://example.test/$1" ]
    },
    {
      "name": "photon",
      "photon": true,
      "mediaRedirectDomain": "",
      "redirectBase": "",
      "contains": [
        "location ^~ /wp-content/uploads/",
        "fastcgi_pass photon:9000;",
        "fastcgi_param SCRIPT_FILENAME /usr/share/webapps/photon/index.php;"
      ]
    },
    {
      "name": "photon-and-redirect",
      "photon": true,
      "mediaRedirectDomain": "https://example.test",
      "redirectBase": "https://example.test",
      "contains": [
        "if (!-f $request_filename)",
        "https://example.test/$1",
        "fastcgi_pass photon:9000;"
      ]
    },
    {
      "name": "redirect-http-path",
      "photon": false,
      "mediaRedirectDomain": "http://example.test/media",
      "redirectBase": "http://example.test/media",
      "contains": [ "http://example.test/media/$1" ]
    },
    {
      "name": "photon-redirect-trailing-slash",
      "photon": true,
      "mediaRedirectDomain": "example.test/media/",
      "redirectBase": "https://example.test/media/",
      "contains": [ "https://example.test/media//$1", "fastcgi_pass photon:9000;" ]
    }
  ],
  "requests": [
    { "path": "/wp-content/uploads/existing.png", "exists": true, "width": 16, "height": 12 },
    {
      "path": "/wp-content/uploads/existing.png?w=8",
      "exists": true,
      "transform": true,
      "width": 8,
      "height": 6
    },
    {
      "path": "/wp-content/uploads/existing-upper.PNG?w=8",
      "exists": true,
      "transform": true,
      "width": 8,
      "height": 6
    },
    { "path": "/wp-content/uploads/local.txt?w=8", "exists": true },
    { "path": "/wp-content/uploads/missing.png", "exists": false },
    { "path": "/wp-content/uploads/missing.png?w=100&h=50", "exists": false, "photonStatus": 400 },
    {
      "path": "/wp-content/uploads/2026/09/missing%20image.jpg?x=a%2Fb&w=100",
      "exists": false,
      "photonStatus": 400
    }
  ]
}
