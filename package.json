{
  "name": "@automattic/vip",
  "version": "4.1.7",
  "description": "The VIP Javascript library & CLI",
  "main": "index.js",
  "bin": {
    "vip": "dist/bin/vip.js"
  },
  "scripts": {
    "typescript:codegen:install-dependencies": "npm install --no-save @graphql-codegen/cli @graphql-codegen/typescript @graphql-codegen/near-operation-file-preset @graphql-codegen/typescript-operations",
    "typescript:codegen:generate": "graphql-codegen",
    "test": "npm run lint && npm run check-types && jest --coverage --testPathIgnorePatterns __tests__/devenv-e2e/",
    "test:e2e:dev-env": "jest -c __tests__/devenv-e2e/jest/jest.config.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "cmd:format": "prettier \"**/*.{js,json,jsx,md,ts,tsx,yml,yaml}\"",
    "cmd:lint": "eslint --ext 'js,jsx,ts,tsx'",
    "prepare": "npm run clean && npm run build",
    "check-types": "tsc",
    "postinstall": "node ./helpers/check-version.js",
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "npm run clean && npm run build && bun helpers/build-bun.mjs",
    "postbuild": "node helpers/mark-cli-executable.js",
    "build:watch": "npm run build && tsc -p tsconfig.build.json --watch --sourceMap",
    "format": "npm run cmd:format -- --write",
    "format:check": "npm run cmd:format -- --check",
    "jest": "jest --testPathIgnorePatterns __tests__/devenv-e2e/",
    "jest:debug": "NODE_ENV=test node --inspect-brk=0.0.0.0:9252 ./node_modules/.bin/jest --forceExit --runInBand --testTimeout=100000000",
    "lint": "npm run cmd:lint .",
    "lint:fix": "npm run cmd:lint . -- --fix",
    "publish-please": "publish-please",
    "prepublishOnly": "node ./helpers/prepublishOnly.js",
    "smoke:release": "node ./helpers/release-smoke-test.js",
    "smoke:single-process": "node --test ./helpers/single-process-smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automattic/vip-cli.git"
  },
  "keywords": [
    "cli",
    "vip",
    "wordpress"
  ],
  "author": "Automattic",
  "contributors": [
    "Josh Betz <j@joshbetz.com>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=8"
  },
  "bugs": {
    "url": "https://github.com/Automattic/vip/issues"
  },
  "homepage": "https://github.com/Automattic/vip#readme",
  "devDependencies": {
    "@automattic/eslint-plugin-wpvip": "^2.0.0",
    "@jest/globals": "^30.0.0",
    "@jest/test-sequencer": "^30.0.0",
    "@types/configstore": "^6.0.2",
    "@types/debug": "^4.1.12",
    "@types/dockerode": "^4.0.1",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/proxy-from-env": "^1.0.4",
    "@types/semver": "^7.5.5",
    "@types/shelljs": "^0.10.0",
    "@types/ssh2": "^1.15.4",
    "@types/xml2js": "^0.4.14",
    "dockerode": "^5.0.0",
    "jest": "^30.0.0",
    "prettier": "npm:wp-prettier@3.0.3",
    "ts-jest": "29.4.15",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@apollo/client": "4.3.5",
    "@automattic/vip-search-replace": "^2.0.0",
    "@json2csv/plainjs": "^7.0.3",
    "@wwa/single-line-log": "^1.1.4",
    "chalk": "^6.0.0",
    "check-disk-space": "4.0.0",
    "cli-columns": "^4.0.0",
    "cli-table3": "^0.6.3",
    "commander": "^15.0.0",
    "configstore": "^8.0.0",
    "debug": "4.4.3",
    "ejs": "^7.0.1",
    "enquirer": "2.4.1",
    "graphql": "17.0.2",
    "graphql-tag": "2.12.7",
    "graphql-ws": "^6.2.0",
    "https-proxy-agent": "^9.0.0",
    "js-yaml": "^5.0.0",
    "jwt-decode": "4.0.0",
    "lando": "github:automattic/lando-cli#9ae6f4f7316dfebfbfb9acd626158388c58dfd44",
    "node-stream-zip": "1.16.0",
    "open": "^11.0.0",
    "proxy-from-env": "^2.0.0",
    "rxjs": "^7.8.2",
    "semver": "7.8.5",
    "shelljs": "^0.10.0",
    "socket.io-client": "^4.5.3",
    "socket.io-stream": "npm:@wwa/socket.io-stream@^0.10.0",
    "socks-proxy-agent": "^10.0.0",
    "ssh2": "1.17.0",
    "tar": "^7.4.0",
    "undici": "^8.5.0",
    "update-notifier": "7.3.1",
    "xml2js": "^0.6.2"
  },
  "optionalDependencies": {
    "@github/keytar": "^7.10.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundleDependencies": [
    "@apollo/client",
    "@automattic/vip-search-replace",
    "@json2csv/plainjs",
    "@wwa/single-line-log",
    "chalk",
    "check-disk-space",
    "cli-columns",
    "cli-table3",
    "commander",
    "configstore",
    "debug",
    "ejs",
    "enquirer",
    "graphql",
    "graphql-tag",
    "graphql-ws",
    "https-proxy-agent",
    "js-yaml",
    "jwt-decode",
    "lando",
    "node-stream-zip",
    "open",
    "proxy-from-env",
    "rxjs",
    "semver",
    "shelljs",
    "socket.io-client",
    "socket.io-stream",
    "socks-proxy-agent",
    "ssh2",
    "tar",
    "undici",
    "update-notifier",
    "xml2js"
  ],
  "allowScripts": {
    "ssh2@1.17.0": true,
    "@github/keytar@7.10.6": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.11.1": true
  }
}
